<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- iOS/iPadOS only: merged by the Tauri CLI into the generated iOS Info.plist (desktop builds ignore this file).
       See docs/projects/ios/BUILD_AND_INSTALL.md. Unverified until the first `tauri ios build`. -->
  <!-- Required: without it iOS terminates the app on first microphone access. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>VoiceLoop records your voice and instruments for looping and practice feedback. Audio stays on this device.</string>
  <!-- Keep loops playing and takes recording while another app is in front. -->
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
  </array>
  <!-- Show the app's Documents folder (projects) in the Files app and allow in-place editing. -->
  <key>UIFileSharingEnabled</key>
  <true/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>
</dict>
</plist>
